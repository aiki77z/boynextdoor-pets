{
  "name": "bnd-desktop-pets",
  "version": "1.0.1",
  "private": true,
  "description": "Electron desktop pet shell wired to six finalized hatch-pet atlases.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bnd.desktoppets",
    "productName": "BOYNEXTDOOR Pets",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "build/icon.ico",
      "index.html",
      "main.js",
      "package.json",
      "pet-data.js",
      "preload.js",
      "styles.css",
      "hatch-runs/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
